{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "indicators",
    "allowlist",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "const": "dacn-knowledge/1.0"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "indicators": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "hex": {
            "type": "string",
            "pattern": "^(?:[a-fA-F0-9]{2}){1,256}$"
          }
        }
      }
    },
    "allowlist": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "hex": {
            "type": "string",
            "pattern": "^(?:[a-fA-F0-9]{2}){1,256}$"
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "hex": {
            "type": "string",
            "pattern": "^(?:[a-fA-F0-9]{2}){1,256}$"
          }
        }
      }
    }
  }
}
