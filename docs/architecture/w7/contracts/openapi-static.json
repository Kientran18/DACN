  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "KnowledgeRollbackIn": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Revision"
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Revision"
          }
        },
        "type": "object",
        "required": [
          "reason",
          "revision",
          "expected_revision"
        ],
        "title": "KnowledgeRollbackIn"
      },
      "KnowledgeIn": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "bundle": {
            "additionalProperties": true,
            "type": "object",
            "title": "Bundle"
          }
        },
        "type": "object",
        "required": [
          "reason",
          "bundle"
        ],
        "title": "KnowledgeIn"
      },
      "CandidateTransitionIn": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "to_state": {
            "type": "string",
            "enum": [
              "TRIAGED",
              "ALLOWLISTED",
              "SUSPICIOUS",
              "REJECTED"
            ],
            "title": "To State"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "type": "object",
        "required": [
          "reason",
          "to_state",
          "expected_revision"
        ],
        "title": "CandidateTransitionIn"
      },
      "StaticIn": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Path"
          },
          "source_event_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Source Event Ids"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "StaticIn"
      }
    }
  }
}
