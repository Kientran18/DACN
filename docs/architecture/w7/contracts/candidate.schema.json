{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "dacn-candidate/1.0"
    },
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "NEW",
        "TRIAGED",
        "ALLOWLISTED",
        "SUSPICIOUS",
        "REJECTED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "string"
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "dacn-static/1.0"
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "extractor_version": {
          "const": "1.0"
        },
        "path": {
          "type": "string"
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "OK",
            "ERROR"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "entropy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 8.000000001
        },
        "file_identity": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "pe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "value": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "UNAVAILABLE"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        "pattern_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "historical_identity": {
          "enum": [
            "UNVERIFIED",
            "HASH_VERIFIED"
          ]
        }
      },
      "required": [
        "schema_version",
        "analysis_id",
        "observed_at",
        "extractor_version",
        "path",
        "source_event_ids",
        "status",
        "error_code",
        "sha256",
        "size_bytes",
        "entropy",
        "file_identity",
        "pe",
        "signature",
        "pattern_ids",
        "historical_identity"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "OK"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer"
              },
              "entropy": {
                "type": "number"
              },
              "error_code": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "dacn-whitelist-verdict/1.0"
        },
        "knowledge_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "knowledge_version": {
          "type": "integer",
          "minimum": 1
        },
        "verdict": {
          "enum": [
            "UNAVAILABLE",
            "ALLOWLISTED",
            "HIT",
            "NO_HIT"
          ]
        },
        "allowlist_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "signature_hit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "dacn-signature-hit/1.0"
            },
            "ioc_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "pattern_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "suppressed": {
              "type": "boolean"
            }
          },
          "required": [
            "schema_version",
            "ioc_ids",
            "pattern_ids",
            "suppressed"
          ]
        },
        "policy": {
          "const": "STATIC_ALLOWLIST_FIRST_BEHAVIOR_UNCHANGED"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "knowledge_revision",
        "knowledge_version",
        "verdict",
        "allowlist_ids",
        "signature_hit",
        "policy",
        "evaluated_at"
      ]
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_version",
        "outcome",
        "subject",
        "contributing_event_ids",
        "matched_fields",
        "missing_fields",
        "coverage_status",
        "severity",
        "severity_reason",
        "dedup_key"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "rule_version": {
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "MATCH",
            "NO_MATCH",
            "INSUFFICIENT_TELEMETRY",
            "PENDING_LATE_EVENTS"
          ]
        },
        "subject": {
          "type": "string"
        },
        "contributing_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_fields": {
          "type": "object"
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage_status": {
          "type": "string"
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity_reason": {
          "type": "string"
        },
        "dedup_key": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "alert_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "state",
    "revision",
    "created_by",
    "analysis",
    "verdict",
    "detection",
    "alert_ids",
    "created_at"
  ]
}
