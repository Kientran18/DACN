{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "rule_version",
    "name",
    "type",
    "severity",
    "status",
    "description"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^(DACN-DET-\\d{3}|DACN-SIG-[0-9a-f]{8})$"
    },
    "legacy_id": {
      "type": "string",
      "pattern": "^DET-\\d{3}$"
    },
    "rule_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "enum": [
        "single",
        "correlation",
        "ioc",
        "scriptblock",
        "sigma"
      ]
    },
    "status": {
      "enum": [
        "enabled",
        "disabled",
        "blocked",
        "candidate"
      ]
    },
    "blocked_reason": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "severity_reason": {
      "type": "string"
    },
    "sysmon_event_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1
    },
    "source_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "event_ids"
        ],
        "properties": {
          "channel": {
            "type": "string"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1
          }
        }
      }
    },
    "severity_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "map"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "context_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "group_by_field": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "detection_source": {
      "enum": [
        "EXTERNAL_DEFENDER",
        "SIGMA"
      ]
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    },
    "base64": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_length"
      ],
      "properties": {
        "min_length": {
          "type": "integer",
          "minimum": 16,
          "maximum": 100000
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_decoded_bytes": {
          "type": "integer",
          "minimum": 64,
          "maximum": 10485760
        }
      }
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "op",
              "value"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "op": {
                "enum": [
                  "equals",
                  "contains_any",
                  "endswith_any",
                  "startswith_any",
                  "regex"
                ]
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              }
            }
          }
        },
        "any": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "op",
              "value"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "op": {
                "enum": [
                  "equals",
                  "contains_any",
                  "endswith_any",
                  "startswith_any",
                  "regex"
                ]
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              }
            }
          }
        }
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "op",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "op": {
            "enum": [
              "equals",
              "contains_any",
              "endswith_any",
              "startswith_any",
              "regex"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          }
        }
      }
    },
    "registry_change_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_field",
        "new_field",
        "drop"
      ],
      "properties": {
        "old_field": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "new_field": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "drop": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NOOP",
              "WEAKEN",
              "STRENGTHEN",
              "CHANGE"
            ]
          }
        }
      }
    },
    "correlation_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_window_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "allowed_lateness_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "window_status": {
      "enum": [
        "TBD_UNCALIBRATED",
        "CALIBRATED"
      ]
    },
    "mitre_technique_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T\\d{4}(\\.\\d{3})?$"
      }
    },
    "mitre_basis": {
      "type": "string"
    },
    "false_positives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_status": {
      "enum": [
        "synthetic_only",
        "lab_verified"
      ]
    },
    "response_policy": {
      "enum": [
        "alert_only"
      ],
      "default": "alert_only"
    },
    "sigma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "level",
        "author",
        "license",
        "origin",
        "source_path",
        "source_sha256",
        "logsource",
        "dacn_logsource",
        "detection"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "test",
            "stable",
            "experimental"
          ]
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "author": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "modified": {
          "type": [
            "string",
            "null"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "enum": [
            "sigmahq",
            "local"
          ]
        },
        "source_path": {
          "type": "string"
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "logsource": {
          "type": "object"
        },
        "dacn_logsource": {
          "type": "object",
          "required": [
            "kind",
            "table",
            "event_ids",
            "fields"
          ]
        },
        "detection": {
          "type": "object",
          "required": [
            "condition"
          ]
        },
        "coverage_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
